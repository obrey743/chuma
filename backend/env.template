NODE_ENV=development
PORT=4100
# PostgreSQL connection string (Neon or Render Postgres). Login and money features need this.
DATABASE_URL=
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PAYMENT_PROVIDER=mock
DEVDRAFT_API_KEY=
DEVDRAFT_BASE_URL=
DEVDRAFT_WEBHOOK_SECRET=
# gemma = real Gemma 4 (needs GEMMA_API_KEY from https://aistudio.google.com/apikey), mock = demo data
AI_PROVIDER=gemma
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
CORS_ORIGIN=http://localhost:5173
# Demo login with sample data, no database needed. Set false when going live.
DEMO_MODE=true
