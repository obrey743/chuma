PORT=4000

# Gemma 4 via Gemini API. Key: https://aistudio.google.com/apikey
# Models: gemma-4-26b-a4b-it (faster) or gemma-4-31b-it (stronger)
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# true = always return mock AI data (use if the API is down during the demo)
AI_MOCK=false

# DevDraft (Developer 2)
DEVDRAFT_API_KEY=
