{
  "name": "chuma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"npm --prefix backend run dev\"",
    "dev:web": "vite",
    "dev:api": "npm --prefix backend run dev",
    "postinstall": "npm --prefix backend install --include=dev",
    "build": "vite build && npm --prefix backend run build",
    "start": "npm --prefix backend start",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
